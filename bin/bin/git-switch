#!/bin/bash

LOCAL_CONFIG="$HOME/.gitconfig.local"

case "$1" in
'private')
git config --file "$LOCAL_CONFIG" user.email tormodlea@gmail.com
;;
'laerdal')
git config --file "$LOCAL_CONFIG" user.email tormod.lea@laerdal.com
;;
*)
git config --file "$LOCAL_CONFIG" user.email tormodlea@gmail.com
;;
esac

git config --global user.name
git config --global user.email
